# Copy this file to .env, then fill in both secrets before running Compose.
# Generate DB_PASSWORD with: openssl rand -hex 24
# Generate JWT_SECRET with: openssl rand -base64 32
# Keep .env local; use your deployment platform's secret storage in production.
DB_USERNAME=taskflow
DB_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION=3600

# For running the application directly against Compose's published database port.
# Compose supplies its own internal DB_URL to the API container.
DB_URL=jdbc:postgresql://localhost:5433/taskflow
